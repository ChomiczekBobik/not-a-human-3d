* text=auto

# Windows-скрипты должны остаться CRLF
*.bat text eol=crlf

# исходники — LF
*.js text eol=lf
*.mjs text eol=lf
*.py text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.json text eol=lf

# бинарные ассеты
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ogg binary
*.glb binary
